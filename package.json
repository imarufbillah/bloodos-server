{
  "name": "bloodos-server",
  "version": "1.0.0",
  "description": "BloodOS Backend API - Express.js with TypeScript ESM",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsc && nodemon dist/server.js",
    "start": "node dist/server.js",
    "init-indexes": "tsc && node dist/scripts/init-indexes.js",
    "verify-indexes": "tsc && node dist/scripts/verify-indexes.js",
    "seed": "tsc && node dist/scripts/seed.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\""
  },
  "keywords": [
    "blood-donation",
    "express",
    "typescript",
    "mongodb"
  ],
  "author": "Maruf Billah",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "jose": "^6.2.3",
    "mongodb": "^7.5.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.1",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0",
    "vitest": "^4.1.10"
  }
}
