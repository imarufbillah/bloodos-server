{
  "name": "bloodos-server",
  "version": "1.0.0",
  "description": "BloodOS Backend API - Express.js with TypeScript ESM",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsc && nodemon dist/server.js",
    "start": "node dist/server.js",
    "init-indexes": "tsc && node dist/scripts/init-indexes.js",
    "verify-indexes": "tsc && node dist/scripts/verify-indexes.js",
    "seed": "tsc && node dist/scripts/seed.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\""
  },
  "keywords": [
    "blood-donation",
    "express",
    "typescript",
    "mongodb"
  ],
  "author": "Maruf Billah",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "ioredis": "^6.0.0",
    "jose": "^6.2.11",
    "mongodb": "^7.6.0",
    "multer": "^2.3.0",
    "sharp": "^0.35.4",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/ioredis": "^5.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.4.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.69.0",
    "vitest": "^5.0.0"
  }
}
